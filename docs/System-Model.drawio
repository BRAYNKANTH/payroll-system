<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram name="1 Hierarchy" id="p-1-hierarchy"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="World Entrepreneurs Company: chain of command (who reports to whom)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="n3" value="Each person reports to someone more senior. Edit a box to change a position or its default pay. Defaults are pre-filled when you add a person and can be changed per person (Settings, Pay defaults)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1100" height="24" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Head office (not in the chain)&lt;/b&gt;&lt;br&gt;Admin: finalizes months, users, settings&lt;br&gt;Accountant: staff, hubs, payroll, approvals, loans, bank file" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="520" height="70" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Coacher&lt;/b&gt; (manager-type, top of the chain)&lt;br&gt;Weekly account + fixed salary, default basic Rs 30,000&lt;br&gt;Reports to nobody" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="210" width="520" height="95" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Manager&lt;/b&gt; (manager-type, runs a hub)&lt;br&gt;Default basic Rs 27,000, paid to the bank&lt;br&gt;Team share: 20% of the month's sales of everyone below, replaces the weekly profit share&lt;br&gt;Weekly sheet costs: rent, hub fee, security, draws&lt;br&gt;Reports to a Coacher" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="345" width="520" height="140" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Promoting manager&lt;/b&gt; (manager-type, works under a manager)&lt;br&gt;Fixed basic Rs 30,000, paid to the bank&lt;br&gt;No weekly account of their own: the guys below them belong to the manager above&lt;br&gt;Can run a team of their own" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="525" width="520" height="110" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Group manager&lt;/b&gt; (guy-type)&lt;br&gt;Monthly pay, staff portal login&lt;br&gt;Sees own pay and the team's sales (not their pay)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="675" width="520" height="95" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Supervisor&lt;/b&gt; (guy-type)&lt;br&gt;Default target Rs 120,000, basic Rs 30,000&lt;br&gt;Under target: 25% of all sales, no basic. Over target: basic + 30% of the part over target&lt;br&gt;Food Rs 150 per day, only after 24 days worked&lt;br&gt;Security 1% of total business" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="810" width="520" height="125" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Distributor / Guy&lt;/b&gt; (guy-type, sells in the field)&lt;br&gt;Default target Rs 100,000, basic Rs 25,000&lt;br&gt;Same 25% / 30% commission rule as a supervisor&lt;br&gt;Food Rs 150 per day from the first day&lt;br&gt;Security 1% of total business" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="975" width="520" height="110" as="geometry"/></mxCell><mxCell id="n11" value="reports to" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n6" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="reports to" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n7" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="reports to" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n8" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="reports to" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n9" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="reports to" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n10" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;dashed=1;endArrow=none;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Hub (branch)&lt;/b&gt;&lt;br&gt;Examples: Jaffna 01, 02, 03, Kilinochchi, Chavakachcheri&lt;br&gt;Each hub has one manager, its staff, daily and weekly sheets, and its own branch stock&lt;br&gt;A hub-limited user (clerk or hub manager) only sees their own hub" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="420" height="180" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Two kinds of pay&lt;/b&gt;&lt;br&gt;&lt;b&gt;Manager-type&lt;/b&gt; (Coacher, Manager, Promoting manager): a running account with the company, plus a fixed salary paid to the bank&lt;br&gt;&lt;b&gt;Guy-type&lt;/b&gt; (Group manager, Supervisor, Distributor): monthly pay worked out from sales, paid to the bank" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="420" height="190" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Chain rules&lt;/b&gt;&lt;br&gt;A person must report to someone of a higher position&lt;br&gt;Rank order: Distributor, Supervisor, Group manager, Promoting manager, Manager, Coacher&lt;br&gt;A guy's payroll manager is the nearest Manager or Coacher above them (a Promoting manager is skipped)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="420" height="160" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Staff portal (guy-types only)&lt;/b&gt;&lt;br&gt;A distributor, supervisor or group manager can have a login that shows only their own sales, target progress, pay estimate, payslips, loans and documents&lt;br&gt;Supervisors and group managers also see their team's sales" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="345" width="420" height="150" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Example: who is in a manager's team&lt;/b&gt;&lt;br&gt;Manager M1&lt;br&gt;&amp;nbsp;&amp;nbsp;Promoting manager PM1 (basic only)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Supervisor S1 &amp;gt; Distributor D1&lt;br&gt;&amp;nbsp;&amp;nbsp;Distributor D2&lt;br&gt;M1's 20% is taken on S1, D1 and D2's sales" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="525" width="420" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Pay rules" id="p-2-pay-rules"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="How pay is worked out" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="n3" value="Nobody types a final salary. Every figure comes from the daily, weekly, stock, allowance and loan records. Amounts are stored in cents." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1200" height="24" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Guy earnings (Distributor, Supervisor, Group manager)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Basic + commission&lt;/b&gt;: basic + commission rate x (business - target)&lt;br&gt;&lt;b&gt;Tiered&lt;/b&gt;:&lt;br&gt;&amp;nbsp;&amp;nbsp;business above target: fixed basic + commission rate x (business - target)&lt;br&gt;&amp;nbsp;&amp;nbsp;business at or below target: base rate x ALL business, no basic&lt;br&gt;&lt;b&gt;Food&lt;/b&gt;: Rs per day x days worked, once the minimum days are reached&lt;br&gt;&lt;b&gt;Allowances&lt;/b&gt;: extra earnings entered for the month&lt;br&gt;Gross = basic + commission + food + allowances" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="480" height="250" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Guy deductions&lt;/b&gt;&lt;br&gt;&lt;b&gt;Settle-up&lt;/b&gt;: business minus the money handed in (daily sheet)&lt;br&gt;&lt;b&gt;Stock shortfall&lt;/b&gt;: max(0, opening + issued - sold - counted) x unit price&lt;br&gt;&lt;b&gt;Personal minus&lt;/b&gt;: advances taken on the daily sheet&lt;br&gt;&lt;b&gt;Security&lt;/b&gt;: none, fixed, % of gross, % of basic or % of business, with an optional lifetime cap&lt;br&gt;&lt;b&gt;Advance or loan instalment&lt;/b&gt;: min(instalment, balance left), taken only from pay left after the other deductions, so it never makes pay negative; the rest stays on the loan" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="480" height="290" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Result for a guy&lt;/b&gt;&lt;br&gt;Net pay = gross - deductions&lt;br&gt;Payable = opening balance + net pay&lt;br&gt;Positive: paid to the bank&lt;br&gt;Negative: carried to next month as money owed (opening balance)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="480" height="170" as="geometry"/></mxCell><mxCell id="n7" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Manager weekly sheet (one row per week)&lt;/b&gt;&lt;br&gt;Business for the week x profit % (20% from Rs 100,000 of weekly business, else 15%)&lt;br&gt;minus rent, hub fee, security cost, personal draw&lt;br&gt;= weekly balance&lt;br&gt;&lt;b&gt;If a manager has a team share set (20%)&lt;/b&gt;: this profit share is replaced by team share x the month's sales of everyone below, taken from the daily sheets. The weekly costs still apply." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="520" height="215" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Manager month&lt;/b&gt;&lt;br&gt;Net = sum of weekly balances (or the team share)&lt;br&gt;&amp;nbsp;&amp;nbsp;- company return (% of weekly business, set in Settings)&lt;br&gt;&amp;nbsp;&amp;nbsp;- net pay of all guys whose payroll manager they are&lt;br&gt;Closing balance = opening + net&lt;br&gt;&lt;b&gt;Fixed salary&lt;/b&gt; (Rs 27,000 / 29,000 / 30,000 by position) is paid to the bank and does not move the balance" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="345" width="520" height="235" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Promoting manager&lt;/b&gt;&lt;br&gt;Fixed basic Rs 30,000 paid to the bank&lt;br&gt;No weekly account. The guys below them are charged to the manager above" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="610" width="520" height="150" as="geometry"/></mxCell><mxCell id="n12" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Exception flags (go to Approvals)&lt;/b&gt;&lt;br&gt;Net pay moved by more than 20% from last month&lt;br&gt;A negative deduction&lt;br&gt;Deductions greater than gross pay (guys)&lt;br&gt;A manager's balance going deeper negative&lt;br&gt;Bank account different from the verified one, or missing&lt;br&gt;Stock shortfall above Rs 5,000&lt;br&gt;Thresholds are in Settings. No flags means auto-approved." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="100" width="420" height="270" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Advances and loans&lt;/b&gt;&lt;br&gt;Advance: taken back in full from one month's pay&lt;br&gt;Loan: fixed monthly instalment until paid off, no interest&lt;br&gt;Only guy-types can get one&lt;br&gt;Balance = amount - repayments in finalized months&lt;br&gt;Old Excel loans can be entered with what was already repaid" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="400" width="420" height="200" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Still to confirm with the owner&lt;/b&gt;&lt;br&gt;Below-target pay, the 1% security rule, the company return and manager profit tiers differ between the Excel sheets&lt;br&gt;The bank file layout is a placeholder" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="630" width="420" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Monthly flow" id="p-3-monthly-flow"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Monthly payroll flow" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="n3" value="Entry and calculation can be repeated as often as needed. Finalizing locks the month in the database." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1300" height="24" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Daily sheet&lt;/b&gt;&lt;br&gt;Clerk or manager: business, handed in, personal minus" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="230" height="80" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Weekly sheet&lt;/b&gt;&lt;br&gt;Manager business, rent, hub fee, draws" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="230" height="80" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Stock count&lt;/b&gt;&lt;br&gt;Per guy per product: opening, issued, sold, counted" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="230" height="80" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Branch stock&lt;/b&gt;&lt;br&gt;Per hub per product: received, given out, counted" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="230" height="80" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Allowances&lt;/b&gt;&lt;br&gt;Extra earnings for the month" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="230" height="80" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Advances and loans&lt;/b&gt;&lt;br&gt;Accountant gives them; the run takes each instalment" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="230" height="80" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Payroll run: Calculate&lt;/b&gt;&lt;br&gt;Accountant&lt;br&gt;Works out every person's pay from the records above. Safe to repeat. Opening balance = last month's closing balance." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="270" width="250" height="150" as="geometry"/></mxCell><mxCell id="n11" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n4" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n5" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n6" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n7" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="Any flags?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="295" width="200" height="100" as="geometry"/></mxCell><mxCell id="n18" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n10" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Auto-approved&lt;/b&gt;&lt;br&gt;No flags" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="150" width="230" height="70" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Approvals queue&lt;/b&gt;&lt;br&gt;Accountant or admin approves, or rejects with a note. Changing a bank account needs a second person to approve (four-eyes)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="270" width="270" height="150" as="geometry"/></mxCell><mxCell id="n21" value="No" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n17" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="Yes" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n17" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Fix the data&lt;/b&gt;&lt;br&gt;Correct the sheet, then Calculate again" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="470" width="260" height="90" as="geometry"/></mxCell><mxCell id="n24" value="Rejected" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n20" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="Recalculate" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n23" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Finalize (admin)&lt;/b&gt;&lt;br&gt;Recalculates once more, needs every flag resolved and earlier months finalized. Locks the month." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="270" width="250" height="150" as="geometry"/></mxCell><mxCell id="n27" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n19" target="n26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="Approved" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n20" target="n26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Month locked&lt;/b&gt;&lt;br&gt;Entries and summaries cannot change (database triggers). Loan repayments are recorded." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="470" width="250" height="110" as="geometry"/></mxCell><mxCell id="n30" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n26" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;Bank file&lt;/b&gt;&lt;br&gt;Pay to each person's account (format still a placeholder)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="640" width="230" height="80" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;Payslips and register&lt;/b&gt;&lt;br&gt;Printable; also in the staff portal" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="640" width="230" height="80" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;Next month&lt;/b&gt;&lt;br&gt;Closing balance becomes the opening balance" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1520" y="640" width="160" height="80" as="geometry"/></mxCell><mxCell id="n34" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n29" target="n31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n29" target="n32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n29" target="n33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;While the month is open&lt;/b&gt;&lt;br&gt;A guy sees an estimate of their pay on the staff portal, marked not final&lt;br&gt;The accountant can recalculate any time&lt;br&gt;After finalizing, the payslip and final pay appear on the portal&lt;br&gt;Download a backup from Settings after each month" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="640" width="560" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 Hub money and stock" id="p-4-hub-money-and-stock"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="How stock, sales and cash move in a hub" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="n3" value="Each arrow is something that gets recorded in the system. Edit labels to match how the business really works." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1300" height="24" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Company stock&lt;/b&gt;&lt;br&gt;Products and unit prices" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="220" height="90" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Hub (branch stock)&lt;/b&gt;&lt;br&gt;Opening, received, given out, counted&lt;br&gt;Difference and stock value each month" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="130" width="240" height="110" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Guy / Supervisor&lt;/b&gt;&lt;br&gt;Takes stock to sell. Counted at month end: opening + issued - sold - counted = shortfall" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="130" width="240" height="110" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Customers&lt;/b&gt;&lt;br&gt;Sales (business)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="130" width="200" height="90" as="geometry"/></mxCell><mxCell id="n8" value="stock received" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="stock issued" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="sells" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Daily sheet&lt;/b&gt;&lt;br&gt;Business amount, money handed in, difference (settle-up minus), personal minus, notes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="330" width="260" height="130" as="geometry"/></mxCell><mxCell id="n12" value="business recorded" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n7" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="hands in cash" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n6" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Manager (hub)&lt;/b&gt;&lt;br&gt;Collects the guys' cash&lt;br&gt;Weekly sheet: business, profit %, rent, hub fee, security, draws" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="330" width="260" height="130" as="geometry"/></mxCell><mxCell id="n15" value="settled amount" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n11" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Guy's monthly pay&lt;/b&gt;&lt;br&gt;Earnings from business and target&lt;br&gt;less settle-up, stock shortfall, personal minus, security, loan instalments" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="530" width="260" height="130" as="geometry"/></mxCell><mxCell id="n17" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n11" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="stock shortfall" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;dashed=1;" edge="1" parent="1" source="n6" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Manager's running account&lt;/b&gt;&lt;br&gt;Profit share or team share&lt;br&gt;less weekly costs, company return and the guys' net pay&lt;br&gt;Salary is paid to the bank separately" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="530" width="260" height="130" as="geometry"/></mxCell><mxCell id="n20" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n14" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="guys' net pay charged" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;dashed=1;" edge="1" parent="1" source="n16" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Bank&lt;/b&gt;&lt;br&gt;Guys' net pay, managers' fixed salary" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="530" width="240" height="90" as="geometry"/></mxCell><mxCell id="n23" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n16" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;Hub rules&lt;/b&gt;&lt;br&gt;The sum of hubs should reconcile to zero in the weekly master (from the Excel process)&lt;br&gt;A hub-limited user only enters data for their own hub" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="330" width="280" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="5 System and roles" id="p-5-system-and-roles"><mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="System, roles and controls" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Browser or phone&lt;/b&gt;&lt;br&gt;Single-page app (plain JavaScript)&lt;br&gt;Can be added to the home screen. Pages: Dashboard, Daily, Weekly, Stock, Branch stock, Allowances, Advances and loans, Payroll run, Approvals, Payslips, Employees, Hubs, Reports, Audit, Users, Settings, My page" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="160" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Server&lt;/b&gt;&lt;br&gt;Vercel serverless function in Singapore (api/index.js). Checks the signed-in user's role on every request. Writes need a custom header." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="260" height="160" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;Neon Postgres in production, embedded PGlite on a laptop. Money stored as whole cents." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="260" height="160" as="geometry"/></mxCell><mxCell id="n6" value="HTTPS" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n7" value="SQL" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Built-in controls&lt;/b&gt;&lt;br&gt;Passwords stored as scrypt hashes; session cookie is HttpOnly; 5 wrong passwords locks the username for 5 minutes&lt;br&gt;Audit trail written by database triggers: every change after first entry, who, when, old and new value&lt;br&gt;Finalized months are locked by database triggers&lt;br&gt;Four-eyes rule: whoever changed a bank account cannot approve the payment to it&lt;br&gt;Advance and loan balances are built from locked repayments, so they cannot drift" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="940" height="150" as="geometry"/></mxCell><mxCell id="n9" value="Roles (each includes the one above it, except Staff portal)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1050" y="100" width="500" height="24" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Staff portal&lt;/b&gt;&lt;br&gt;Own sales, pay, payslips, loans, documents only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="135" width="520" height="90" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Viewer&lt;/b&gt;&lt;br&gt;Read everything, change nothing" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="240" width="520" height="90" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Clerk&lt;/b&gt;&lt;br&gt;Viewer + enter daily, weekly, stock and allowance sheets (optionally one hub)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="345" width="520" height="90" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Hub manager&lt;/b&gt;&lt;br&gt;Clerk + register their own hub's team (never managers)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="450" width="520" height="90" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Accountant&lt;/b&gt;&lt;br&gt;Hub manager + manage staff and hubs, give loans, run payroll, approve or reject, export files" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="555" width="520" height="90" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Admin&lt;/b&gt;&lt;br&gt;Accountant + finalize months, manage users, change settings" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="660" width="520" height="90" as="geometry"/></mxCell><mxCell id="n16" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Hosting and running&lt;/b&gt;&lt;br&gt;Code on GitHub (BRAYNKANTH/payroll-system), deployed from the master branch to Vercel&lt;br&gt;Backups: Neon keeps point-in-time history; admins can also download a full copy from Settings&lt;br&gt;Local demo: npm run demo (database in data/demo)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="940" height="130" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Not built yet&lt;/b&gt;&lt;br&gt;EPF, ETF and income tax; leave and attendance; payslips by WhatsApp or SMS; Tamil and Sinhala; two-factor sign-in and admin password reset; corrections to a finalized month; final pay when someone leaves; confirmed bank file format" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="940" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
